# MoTech auth API - environment variables.
# Copy to .env (never commit it) and export the values, or set them in your hosting provider.

NODE_ENV=development
PORT=4000

# REQUIRED in production: a random string of at least 32 characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Browser origin(s) of the web app (comma separated). Used for CORS and the Origin check.
CORS_ORIGIN=http://localhost:3000

# Cookies. In production serve over HTTPS, keep COOKIE_SECURE=true.
# Same-site deployment (web app and /api on one domain): COOKIE_SAMESITE=strict
# Cross-site deployment (separate domains): COOKIE_SAMESITE=none (requires COOKIE_SECURE=true)
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
# COOKIE_DOMAIN=

# Set to the number of reverse-proxy hops in front of the API (e.g. 1) so client IPs are correct.
# TRUST_PROXY=1

# Session lifetimes (seconds)
# ACCESS_TTL_SECONDS=900
# REFRESH_TTL_SECONDS=28800
# REMEMBER_TTL_SECONDS=2592000

# Brute-force protection
# LOCKOUT_MAX_FAILURES=5
# LOCKOUT_DURATION_SECONDS=900
# IP_RATE_LIMIT_MAX=60

# Password reset by SMS.
#   console  - prints the code in the server log (development only)
#   webhook  - POSTs {to, message} to SMS_WEBHOOK_URL (forward it to your SMS gateway)
#   disabled - password reset unavailable (default in production)
SMS_MODE=console
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_TOKEN=

# Where users and meters are stored (JSON file). Replace the Store with a database for real deployments.
# DATA_FILE=data/store.json

# Seed script (npm run seed)
# ADMIN_EMAIL=you@example.com
# ADMIN_NAME=Your Name
# ADMIN_PHONE=+254700000000
# ADMIN_PASSWORD=          # optional; a random one is generated if omitted
# METER_COUNT=50
