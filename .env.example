# Web app (Vite) environment. Copy to .env.local. Only VITE_* values reach the browser,
# so NEVER put secrets here.

# Base URL of the auth API. Leave empty to use the same-origin "/api" (recommended: in
# development Vite proxies /api to the API on :4000, in production proxy /api at your web server).
VITE_API_BASE_URL=

# Dev only: where the Vite dev server forwards /api requests
# VITE_DEV_API_TARGET=http://localhost:4000

VITE_APP_NAME=MoTech Smart Energy Platform
