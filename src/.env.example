# Hydrobox SmartMeter - Environment Variables Template
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# Application Settings
VITE_APP_NAME=Hydrobox SmartMeter
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# API Configuration
VITE_API_BASE_URL=http://localhost:3000/v1
VITE_WS_URL=ws://localhost:3000/v1/ws
VITE_API_TIMEOUT=30000

# Security Settings
VITE_SESSION_DURATION=28800000
VITE_ENCRYPTION_KEY=your-secure-encryption-key-here-change-in-production

# API Authentication (Frontend)
# IMPORTANT: Never expose device API keys in frontend code
# These are for dashboard user authentication only
VITE_API_PUBLIC_KEY=your-public-api-key-here

# Rate Limiting
VITE_LOGIN_MAX_ATTEMPTS=5
VITE_CHAT_MAX_ATTEMPTS=20
VITE_FORM_MAX_ATTEMPTS=10

# Feature Flags
VITE_ENABLE_AI_CHAT=true
VITE_ENABLE_EXPORTS=true
VITE_ENABLE_DIAGNOSTICS=true
VITE_ENABLE_REALTIME=true
VITE_ENABLE_WEBSOCKET=true

# Monitoring (optional)
# VITE_SENTRY_DSN=your-sentry-dsn
# VITE_ANALYTICS_ID=your-analytics-id

# ============================================
# BACKEND ENVIRONMENT VARIABLES
# (Not used by frontend, for reference only)
# ============================================

# Database
# DATABASE_URL=postgresql://user:password@localhost:5432/hydrobox
# DATABASE_POOL_SIZE=20

# Redis
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password

# Message Queue
# RABBITMQ_URL=amqp://localhost:5672
# KAFKA_BROKERS=localhost:9092

# JWT Configuration
# JWT_SECRET=your-jwt-secret-key-minimum-32-characters
# JWT_EXPIRATION=8h
# JWT_REFRESH_EXPIRATION=7d

# Device API Keys
# DEVICE_API_KEY_SALT=your-bcrypt-salt-rounds-10-or-higher

# Encryption
# ENCRYPTION_KEY=your-256-bit-hex-encryption-key
# ENCRYPTION_ALGORITHM=aes-256-gcm

# Rate Limiting (Backend)
# RATE_LIMIT_DEVICE=1000/hour
# RATE_LIMIT_USER=10000/hour
# RATE_LIMIT_GLOBAL=1000000/hour

# WebSocket
# WS_PORT=3001
# WS_PATH=/v1/ws
# WS_PING_INTERVAL=30000

# SMTP (for alerts)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# SMS (for alerts)
# SMS_PROVIDER=twilio
# SMS_API_KEY=your-sms-api-key
# SMS_FROM_NUMBER=+254700000000

# Monitoring
# SENTRY_DSN=your-backend-sentry-dsn
# NEW_RELIC_LICENSE_KEY=your-new-relic-key

# IMPORTANT SECURITY NOTES:
# 1. Never expose device API keys or secrets in client-side code
# 2. Use backend proxy for all sensitive API calls
# 3. Rotate keys regularly (monthly for production)
# 4. Use different keys for development, staging, and production
# 5. Keep this file out of version control (.gitignore)
# 6. Use a secrets management service (AWS Secrets Manager, HashiCorp Vault) in production
# 7. Enable audit logging for all key access
# 8. Implement key rotation without downtime
# 9. Monitor for unauthorized key usage
# 10. Use hardware security modules (HSM) for production keys